# Image references pushed to ECR
BACKEND_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/pos-backend:v1
FRONTEND_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/pos-frontend:v1

# Postgres (MVP in-container)
POSTGRES_DB=pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-this-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,api.your-domain.com,localhost,127.0.0.1

# CORS/CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
ENABLE_FILE_LOGGING=False

# Startup/runtime
DB_WAIT_ENABLED=true
DB_WAIT_TIMEOUT=90
DB_WAIT_INTERVAL=3
MIGRATE_ON_START=true
COLLECTSTATIC_ON_START=true
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional one-time superuser bootstrap
CREATE_DJANGO_SUPERUSER=False
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=

# DB connectivity (for local Postgres service)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos
DB_USER=pos_user
DB_PASSWORD=change-this-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# When moving to RDS later, set this and keep DB_HOST/DB_PORT as fallback:
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require
