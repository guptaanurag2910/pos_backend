# ---------------------------
# Docker Compose (FE + BE)
# DB is not containerized here.
# ---------------------------

DJANGO_SECRET_KEY=django-insecure-p0s-backend-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CREATE_DJANGO_SUPERUSER=False
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos
# Matches current local testing credentials from Django settings.
DB_USER=anurag
DB_PASSWORD=
# From Docker container, host machine DB is reachable via host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_SSLMODE=prefer

# Optional override for hosted/external PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Frontend API base URL for Docker build.
# Keep "/" when using nginx proxy in the frontend container.
VITE_API_BASE_URL=/
