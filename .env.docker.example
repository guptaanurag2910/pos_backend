# ---------------------------
# Docker Compose (FE + BE + Postgres)
# Default mode uses dockerized Postgres.
# ---------------------------
POSTGRES_DB=pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=django-insecure-p0s-backend-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CREATE_DJANGO_SUPERUSER=False
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos
# Matches dockerized postgres defaults above.
DB_USER=pos_user
DB_PASSWORD=pos_password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Optional override for hosted/external PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Frontend API base URL for Docker build.
# Keep "/" when using nginx proxy in the frontend container.
VITE_API_BASE_URL=/
