# ----------------------------------------
# Podman/Docker Compose (FE + BE + Postgres)
# ----------------------------------------
POSTGRES_DB=pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Backend image references (used in AWS/registry workflows).
BACKEND_IMAGE=pos-backend:latest
FRONTEND_IMAGE=pos-frontend:latest

DJANGO_SECRET_KEY=change-this-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
ENABLE_FILE_LOGGING=False

# Runtime/startup controls
DB_WAIT_ENABLED=true
DB_WAIT_TIMEOUT=90
DB_WAIT_INTERVAL=3
MIGRATE_ON_START=true
COLLECTSTATIC_ON_START=true
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional bootstrap superuser
CREATE_DJANGO_SUPERUSER=False
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=

# Database fallback values
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos
DB_USER=pos_user
DB_PASSWORD=change-this-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Optional hosted/external PostgreSQL. If set, it takes priority over DB_*.
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Frontend API base URL for build (keep "/" with nginx proxy).
VITE_API_BASE_URL=/
