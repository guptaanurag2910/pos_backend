# ---------------------------
# Podman Compose (FE + BE + Postgres)
# ---------------------------
POSTGRES_DB=pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=django-insecure-p0s-backend-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

CREATE_DJANGO_SUPERUSER=True
DJANGO_SUPERUSER_EMAIL=admin@pos.local
DJANGO_SUPERUSER_NAME=Admin
DJANGO_SUPERUSER_PASSWORD=Admin@12345
# Django admin login at /admin uses EMAIL + PASSWORD (not username).
# Keep these values stable so container restart does not change admin access.
DJANGO_ADMIN_SITE_HEADER=Django administration
DJANGO_ADMIN_SITE_TITLE=Django site admin
DJANGO_ADMIN_INDEX_TITLE=Site administration

DB_ENGINE=django.db.backends.postgresql
DB_NAME=pos
DB_USER=pos_user
DB_PASSWORD=pos_password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Optional override for hosted/external PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Frontend API base URL for build.
# Default points directly to backend service URL.
VITE_API_BASE_URL=http://localhost:8000/
