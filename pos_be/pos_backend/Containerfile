# Use Quay-hosted open images (avoid Docker Hub/AWS Public ECR).
ARG PYTHON_BASE_IMAGE=quay.io/sclorg/python-310-c9s:latest
FROM ${PYTHON_BASE_IMAGE}

# Python runtime flags:
# - no .pyc files
# - immediate logs to stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

# Run migrations + optional superuser creation + start Gunicorn.
CMD ["/app/entrypoint.sh"]
